# Chave da API da Anthropic (obrigatória para o assistente de IA funcionar)
ANTHROPIC_API_KEY=

# Segredo usado para assinar tokens de conversa e a sessão do painel.
# Use uma string longa e aleatória (ex.: openssl rand -hex 32).
CONVERSA_SECRET=

# Credenciais do painel administrativo (/admin).
# ADMIN_PASSWORD é obrigatória — sem ela o painel fica bloqueado.
ADMIN_USER=martins
ADMIN_PASSWORD=

# WhatsApp oficial da Martins Imóveis (somente dígitos, com DDI).
# Mantenha igual à constante WHATSAPP_MARTINS de public/app.js.
WHATSAPP_NUMBER=5511982313938

# Diretório do banco de dados e das fotos enviadas pelo painel.
# Local: deixe vazio (usa ./data). Railway: aponte para o Volume (ex.: /data).
DATA_DIR=

# Porta do servidor (padrão 3000)
PORT=3000

# Domínios externos autorizados a consumir a API via CORS (separados por vírgula).
# Normalmente vazio: site e API são servidos pela mesma origem.
ALLOWED_ORIGIN=
